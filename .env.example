# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Development database — holds the demo seed data.
DATABASE_URL="postgresql://pcs_app:CHANGE_ME@localhost:5432/product_studio"

# Test database — wiped and re-seeded by the automated tests.
# Must be a DIFFERENT database from DATABASE_URL.
TEST_DATABASE_URL="postgresql://pcs_app:CHANGE_ME@localhost:5432/product_studio_test"

# Seed administrator credentials. Documented in README.md.
SEED_ADMIN_EMAIL="admin@studio.local"
SEED_ADMIN_PASSWORD="CHANGE_ME"

# Base URL used by the Playwright end-to-end suite.
E2E_BASE_URL="http://localhost:3000"
